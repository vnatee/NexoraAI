# Copy this file to .env.local-mongodb and replace both password values.
# Generate URI-safe passwords with: openssl rand -hex 24
NEXORA_MONGO_IMAGE=mongo:8.0
NEXORA_MONGO_PORT=27017
NEXORA_MONGO_DB_NAME=nexora
NEXORA_MONGO_ROOT_USERNAME=nexora_root
NEXORA_MONGO_ROOT_PASSWORD=replace_with_a_unique_generated_value
NEXORA_MONGO_APP_USERNAME=nexora_app
NEXORA_MONGO_APP_PASSWORD=replace_with_a_different_generated_value

# These two values are consumed by the NexoraAI backend when it runs on the host.
MONGO_DB_NAME=nexora
MONGO_URI=mongodb://nexora_app:replace_with_a_different_generated_value@127.0.0.1:27017/nexora?authSource=nexora

# Maximum combined multipart request size. The default is 100 MiB.
MAX_UPLOAD_SIZE_BYTES=104857600
