# Copy to .env.local-storage and replace both credentials.
NEXORA_MINIO_IMAGE=minio/minio:RELEASE.2025-07-23T15-54-02Z
NEXORA_MINIO_API_PORT=9000
NEXORA_MINIO_CONSOLE_PORT=9001

KNOWLEDGE_STORAGE_PROVIDER=minio
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_SECURE=false
MINIO_ACCESS_KEY=replace_with_a_unique_generated_value
MINIO_SECRET_KEY=replace_with_a_different_generated_value
MINIO_KNOWLEDGE_BUCKET=nexora-knowledge
