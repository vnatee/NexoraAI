# Copy to .env.local-embedding. This development service is loopback-only.
NEXORA_OLLAMA_IMAGE=ollama/ollama:0.11.4
NEXORA_OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_PARALLEL=1

# Ollama exposes an OpenAI-compatible embeddings endpoint.
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_API_KEY=ollama
USE_VECTORS=true

# Do not reuse a collection created with a different model or dimension.
QDRANT_COLLECTION=nexora-knowledge-bge-m3
