# Copy only the required values into the protected deployment environment.
# Never commit API keys, worker tokens, registry passwords, or model credentials.

# Pin upgrades explicitly and validate them before production rollout.
GPUSTACK_IMAGE=gpustack/gpustack:v2.3.1

# Optional local image name produced by the InsightSphere branding overlay.
# The original GPUSTACK_IMAGE remains the immediate rollback target.
GPUSTACK_BRANDED_IMAGE=nexoraai-gpustack:v2.3.1-insightsphere

# The administration UI remains loopback-only by default. Reach it through an
# authenticated administration path or SSH tunnel; do not publish it directly.
GPUSTACK_BIND_ADDRESS=127.0.0.1
GPUSTACK_PORT=18080

# InsightSphere uses this only for System Health. In the supplied Compose
# topology, keep the private service URL below.
GPUSTACK_CONTROL_PLANE_URL=http://gpustack:80

