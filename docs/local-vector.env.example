# Copy to .env.local-vector. Do not commit real API keys.
NEXORA_QDRANT_IMAGE=qdrant/qdrant:v1.15.5
NEXORA_QDRANT_HTTP_PORT=6333
NEXORA_QDRANT_GRPC_PORT=6334

KNOWLEDGE_SEARCH_PROVIDER=qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=nexora-knowledge
# Optional when Qdrant is loopback-only. Required when Qdrant is exposed remotely.
QDRANT_API_KEY=

# Qdrant requires embeddings. Existing Azure/OpenAI/OpenAI-compatible embedding
# provider settings remain valid and determine the collection vector size.
USE_VECTORS=true
