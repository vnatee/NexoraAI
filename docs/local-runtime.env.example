# Copy to .env.local-runtime and replace every replace_with_* value.
# Keep this file outside source control; .env.* is ignored.
NEXORA_APP_IMAGE=nexoraai:local
NEXORA_BIND_ADDRESS=127.0.0.1
NEXORA_APP_PORT=50505

# Optional production TLS gateway. The directory must contain fullchain.pem
# and privkey.pem and must not be stored in this repository.
NEXORA_TLS_CERT_DIR=/opt/nexora/tls
NEXORA_HTTP_BIND_ADDRESS=0.0.0.0
NEXORA_HTTP_PORT=80
NEXORA_HTTPS_BIND_ADDRESS=0.0.0.0
NEXORA_HTTPS_PORT=443
NEXORA_NGINX_IMAGE=nginx:1.27.5-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10

# Generate URI-safe MongoDB passwords with: openssl rand -hex 24
NEXORA_MONGO_ROOT_USERNAME=nexora_root
NEXORA_MONGO_ROOT_PASSWORD=replace_with_a_unique_generated_value
NEXORA_MONGO_APP_USERNAME=nexora_app
NEXORA_MONGO_APP_PASSWORD=replace_with_a_different_generated_value
NEXORA_MONGO_DB_NAME=nexora

# Generate MinIO credentials with openssl rand -hex 24 and openssl rand -hex 32.
MINIO_ACCESS_KEY=replace_with_a_unique_generated_value
MINIO_SECRET_KEY=replace_with_a_different_generated_value
MINIO_KNOWLEDGE_BUCKET=nexora-knowledge

# Generate once with the command documented in docs/local-runtime.md and keep stable.
APP_DATA_ENCRYPTION_KEY=replace_with_a_fernet_key
# Generate independently with: openssl rand -hex 32
# Configure these during the initial installation so a System Administrator can
# provision Azure MCP instances later without host access.
INTEGRATION_CONTROLLER_TOKEN=replace_with_a_different_long_random_value
AZURE_MCP_IMAGE=mcr.microsoft.com/azure-sdk/azure-mcp@sha256:replace_with_verified_digest
NEXORA_RUNTIME_NETWORK=nexoraai_runtime
AZURE_MCP_CPU_LIMIT=0.5
AZURE_MCP_MEMORY_LIMIT=512m
AZURE_MCP_STARTUP_TIMEOUT_SECONDS=60
AZURE_MCP_COLLECT_TELEMETRY=false
# One-time first-administrator token. Remove it after bootstrap and restart app.
LOCAL_AUTH_BOOTSTRAP_TOKEN=replace_with_a_long_random_one_time_token

SYSTEM_ADMIN_EMAIL=admin@nexora.local
SYSTEM_ADMIN_FIRST_NAME=System
SYSTEM_ADMIN_LAST_NAME=Administrator
SYSTEM_ADMIN_EMPLOYEE_ID=LOCAL-ADMIN
SYSTEM_ADMIN_TEL=

EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
LLM_MODEL=qwen3:8b
QDRANT_COLLECTION=nexora-knowledge-bge-m3
MAX_UPLOAD_SIZE_BYTES=104857600
# Initial Chat history retention: 30, 90, 180, 365, or 0 for no expiry.
# Saved System/Team Portal policies override this value.
CHAT_HISTORY_RETENTION_DAYS=90
CHAT_HISTORY_CLEANUP_INTERVAL_SECONDS=3600
